{
  "name": "quan-ly-heo-nai",
  "version": "1.0.0",
  "description": "Web quan ly heo nai theo tung trai - phan quyen Admin / Nhan vien cham soc / Nguoi xem",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
