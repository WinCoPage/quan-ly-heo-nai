PORT=3000
# Generate a strong value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace_with_a_random_value_at_least_32_characters
# PostgreSQL connection string (Neon). Required. Example:
# postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Set to 1 only for a local non-SSL PostgreSQL instance during development.
# PGSSL_DISABLE=1
# Absolute path to the legacy SQLite file, only used by scripts/migrate-sqlite-to-postgres.js.
# DATABASE_PATH=/var/lib/winco/data.sqlite
# Directory for scripts/backup-postgres.js output (defaults to ./backups).
# BACKUP_DIR=/var/lib/winco/backups
# Number of recent backups to keep (defaults to 14).
# BACKUP_RETENTION=14
# Set only when the server is reachable exclusively through this many trusted proxies.
TRUST_PROXY_HOPS=0
NODE_ENV=production
